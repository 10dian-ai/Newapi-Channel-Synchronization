# 复制为 .env 后填写。docker compose 会自动读取同目录的 .env。

# 主站数据库（只读账号）
MASTER_DSN=newapi_sync_ro:请改成密码@tcp(主站数据库地址:3306)/new-api

# 子站 1：数据库 + 管理接口
CHILD1_DSN=newapi_sync:请改成密码@tcp(子站1数据库地址:3306)/new-api
CHILD1_URL=https://child1.example.com
CHILD1_TOKEN=nap_请改成子站1的访问令牌

# 子站 2：只配数据库（PostgreSQL 示例）
CHILD2_DSN=postgresql://newapi_sync:请改成密码@子站2数据库地址:5432/new-api

# 时区（日志时间）
TZ=Asia/Shanghai
